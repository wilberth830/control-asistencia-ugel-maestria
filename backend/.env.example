APP_NAME=CHIQUISTRUKIS API
APP_ENV=development
APP_DEBUG=true

ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=localhost:1521/FREEPDB1

# Redis desactivado temporalmente en backend/app/services/session_store.py.
REDIS_URL=redis://127.0.0.1:6379/0

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Desarrollo local sin Redis. En producción usar false y levantar infra/redis.
APP_ALLOW_MEMORY_SESSION=true

# Adjuntos de justificaciones (PDF/JPG/PNG/WEBP, máximo 5 MB por defecto).
SUPPORT_FILES_DIR=storage/support_files
SUPPORT_FILE_MAX_BYTES=5242880

# IA desactivada por defecto. No colocar secretos reales en el repo.
AI_ENABLED=false
AI_PROVIDER=
AI_MODEL=
AI_MIN_CONFIDENCE=0.7
OPENAI_API_KEY=
